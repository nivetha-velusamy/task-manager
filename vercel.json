{
  "version": 2,
  "rewrites": [
    {
      "source": "/tasks/:id*",
      "destination": "/api/index.js"
    },
    {
      "source": "/tasks",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
